# PowerShell: $env:STUDIO_PASSWORD="guclu-sifre"
# bash: export STUDIO_PASSWORD="guclu-sifre"
STUDIO_PASSWORD=CHANGE_ME_USE_A_LONG_UNIQUE_PASSWORD
STUDIO_HOST=127.0.0.1
STUDIO_PORT=4173
# Opsiyonel: kişisel PC'de /usr/bin/chromium; başka sistemlerde playwright kendi Chromium'unu kullanabilir.
# BROWSER_BIN=/usr/bin/chromium
# Opsiyonel seslendirme: varsayılan espeak (Türkçe yerel ses)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# Yayın servisleri v0.1'de kasıtlı olarak devre dışı; önce test hesabında izin ve denetim gerekir.
